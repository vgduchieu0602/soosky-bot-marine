# HTTP server for private health checks and legacy vessel lookup endpoints.
# Bind loopback only; publish the map through a reverse proxy if it must be
# reachable. Set 0.0.0.0 only when the host firewall already restricts access.
HTTP_HOST=127.0.0.1
PORT=3000

# Required. The HTTP server refuses to start while this is empty. Callers send
# it as the X-API-Key header on GET /vessel/:id and every /watchlist route.
# Generate a random value per environment and inject it from the systemd
# EnvironmentFile — never commit a real key.
API_KEY=

# Legacy persistence for detail lookup/watchlist only. Do not point this at the
# Soosky Marine production MongoDB.
MONGODB_URI=mongodb://localhost:27017/crawlbot
REDIS_URL=
CACHE_TTL_MS=60000

# Map freshness. A latest position older than POSITION_STALE_AFTER_MS is never
# returned by the API and is deleted from latest_positions by the cleanup that
# runs every POSITION_CLEANUP_EVERY_MS. Vessel metadata and position history are
# kept. Both must be positive numbers or startup fails.
POSITION_STALE_AFTER_MS=86400000
POSITION_CLEANUP_EVERY_MS=3600000

# Optional VesselFinder detail polling for a small, explicit watchlist.
WATCHLIST=9811983
CRAWL_EVERY_MS=21600000
CRAWL_DELAY_MS=3000

# VesselFinder map scan. Each region is minLat,minLon,maxLat,maxLon; separate
# regions with semicolons. Start small and add coverage only after monitoring.
# US East Coast; United Kingdom; Norway.
SCAN_BBOX=24,-82,47,-66;49,-8,61,2;57,4,72,32

# One completed scan is followed by a six-hour wait. This rate reduces load;
# it does not bypass source restrictions or guarantee that the source permits use.
SCAN_INTERVAL_MS=21600000
SCAN_TILE_DELAY_MS=15000
SCAN_ZOOM=9
SCAN_SUBDIVIDE_THRESHOLD=400
SCAN_MIN_TILE_DEG=1
SCAN_BLOCK_COOLDOWN_MS=43200000

# Optional metadata enrichment. STANDALONE worker: run it with `npm run enrich`.
# The HTTP server never starts it, so upstream request volume stays predictable.
# Keep it disabled (ENRICH_BATCH_SIZE=0) until the regional scan is stable,
# because it makes additional upstream requests.
ENRICH_BATCH_SIZE=0
ENRICH_DELAY_MS=3000
ENRICH_INTERVAL_MS=21600000
