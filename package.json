{
  "name": "crawlbot",
  "version": "3.0.0",
  "description": "VesselFinder regional vessel scanner \u2014 TypeScript + Clean Architecture",
  "main": "dist/interfaces/http/server.js",
  "scripts": {
    "build": "tsc",
    "start:bot": "node dist/interfaces/runtime/production.js",
    "runtime:load-poc": "ts-node src/interfaces/cli/marineAisLoadSim.ts",
    "start": "ts-node src/interfaces/http/server.ts",
    "get": "ts-node src/interfaces/cli/getVessel.ts",
    "crawl": "ts-node src/interfaces/cli/crawlOnce.ts",
    "scan": "ts-node src/interfaces/cli/scanArea.ts",
    "enrich": "ts-node src/interfaces/cli/enrichTypes.ts",
    "audit": "ts-node src/interfaces/cli/auditData.ts",
    "check-drift": "ts-node src/interfaces/cli/detectHtmlDrift.ts",
    "shipinfo:smoke": "ts-node src/interfaces/cli/shipinfoSmoke.ts",
    "shipinfo:poc": "ts-node src/interfaces/cli/shipinfoPoc.ts",
    "shipfinder:smoke": "ts-node src/interfaces/cli/shipfinderSmoke.ts",
    "shipfinder:poc": "ts-node src/interfaces/cli/shipfinderPoc.ts",
    "acquire:free:poc": "ts-node src/interfaces/cli/acquireFreePoc.ts",
    "fallback:cost": "ts-node src/interfaces/cli/fallbackCostSim.ts",
    "marine-ais:poc": "ts-node src/interfaces/cli/marineAisPoc.ts",
    "marine-ais:buffer-sim": "ts-node src/interfaces/cli/marineAisBufferSim.ts",
    "marine-ais:load-sim": "ts-node src/interfaces/cli/marineAisLoadSim.ts",
    "marine-ais:mongo-load-poc": "ts-node src/interfaces/cli/marineAisMongoLoadPoc.ts",
    "map:backfill-location": "ts-node src/interfaces/cli/backfillMapLocation.ts",
    "map:query-poc": "ts-node src/interfaces/cli/mapQueryPoc.ts",
    "map:cluster-poc": "ts-node src/interfaces/cli/mapClusterPoc.ts",
    "test": "node -r ts-node/register --test --test-force-exit \"src/**/*.test.ts\"",
    "contract:parity": "node scripts/check-contract-parity.mjs",
    "reset-indexes": "ts-node src/interfaces/cli/resetIndexes.ts",
    "start:prod": "node dist/interfaces/http/server.js",
    "bot:discovery": "ts-node src/interfaces/cli/botDataProof.ts --mode=discovery",
    "bot:map": "ts-node src/interfaces/cli/botDataProof.ts --mode=map",
    "bot:map-proof": "ts-node src/interfaces/cli/botDataProof.ts --mode=map --pages=10 --reset-checkpoint",
    "bot:detail-proof": "ts-node src/interfaces/cli/botDataProof.ts --mode=detail",
    "bot:detail-sample": "ts-node src/interfaces/cli/botDataProof.ts --mode=detail",
    "bot:continuous": "ts-node src/interfaces/cli/botDataProof.ts --mode=continuous",
    "bot:data-report": "ts-node src/interfaces/cli/botDataProof.ts --mode=report",
    "bot:data-proof": "ts-node src/interfaces/cli/botDataProof.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "mongoose": "^9.7.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
